# ---------------------------------------------------------------------------
# Hyper-Cluster Omega -- configuration template
# Copy to `.env` and fill in. Every key is optional; the defaults work for a
# local development cluster. Secrets are never logged (they are redacted in
# /v1/status and in the log formatter).
# ---------------------------------------------------------------------------

# --- identity --------------------------------------------------------------
HYPER_CLUSTER_NAME=hyper-cluster-omega

# --- control plane ---------------------------------------------------------
HYPER_HEAD_HOST=0.0.0.0
HYPER_HEAD_PORT=8080
# Public URL used by the mobile dashboard (behind a tunnel/reverse proxy).
HYPER_PUBLIC_BASE_URL=

# --- authentication --------------------------------------------------------
# Phone clients present this as `Authorization: Bearer <api_key>`.
HYPER_API_KEY=change-me-please-use-32-random-chars
# Workers present this as `X-Mesh-Token` when registering.
HYPER_MESH_TOKEN=change-me-mesh-token
# Admin operations (drain/remove workers, manage credentials).
HYPER_ADMIN_TOKEN=change-me-admin-token

# --- storage ---------------------------------------------------------------
HYPER_DATA_DIR=~/.hypercluster

# --- worker lifecycle ------------------------------------------------------
# Session lifetime of a provisioned worker (Kaggle/HF runners are ~12h).
HYPER_WORKER_TTL_SECONDS=3600
# Replace a worker this long *before* it expires (10 minutes).
HYPER_HANDOFF_LEAD_SECONDS=600
HYPER_MAX_CONCURRENCY_PER_WORKER=2
HYPER_HEARTBEAT_INTERVAL_SECONDS=20

# --- VRAM auto-scaler (milestone 3) ----------------------------------------
# Hot-swap GGUF models across the mesh when the demand (or the VRAM) changes.
HYPER_AUTOSCALER_ENABLED=1
# Safety margin applied to every model/VRAM fit check.
HYPER_AUTOSCALER_SAFETY_FACTOR=1.15
# The minimum intelligence gain that justifies a hot-swap.
HYPER_AUTOSCALER_MIN_GAIN=0.05
# Anti-thrash timer: a node keeps its model this long after a swap.
HYPER_AUTOSCALER_MIN_DWELL_SECONDS=120
# How many models may change per tick.
HYPER_AUTOSCALER_MAX_CHANGES_PER_TICK=1

# --- headless compute spawner (milestone 3) -------------------------------
# Provision compute without a human: Kaggle kernels, HF Spaces, GitHub
# Actions, Oracle Compute and the free edge APIs.
HYPER_SPAWNER_ENABLED=0
# The order in which the providers are tried.
HYPER_SPAWNER_PROVIDERS=kaggle,hf_spaces,github_actions,oracle
# The pool never drops below this many healthy workers.
HYPER_SPAWNER_MIN_WORKERS=1
# How often the rotator looks for expiring sessions.
HYPER_SPAWNER_TICK_SECONDS=15
# How long a provisioned instance may take to register.
HYPER_SPAWNER_REGISTRATION_TIMEOUT_SECONDS=900
# The session lifetime the spawner asks the provider for.
HYPER_SPAWNER_DEFAULT_TTL_SECONDS=3600
# How many instances may be provisioned at the same time.
HYPER_SPAWNER_MAX_PARALLEL_PROVISIONS=2

# --- scheduling ------------------------------------------------------------
HYPER_SCHEDULER_LATENCY_WEIGHT=1.0
HYPER_SCHEDULER_QUEUE_WEIGHT=0.85
HYPER_SCHEDULER_LOAD_WEIGHT=0.5
HYPER_SCHEDULER_COLD_START_PENALTY_MS=8000

# --- hold & requeue --------------------------------------------------------
HYPER_HOLD_ENABLED=1
HYPER_HOLD_QUEUE_MAX_SIZE=512
HYPER_HOLD_REQUEST_TTL_SECONDS=900

# --- reasoning modes -------------------------------------------------------
HYPER_DEFAULT_MODE=auto
HYPER_COUNCIL_SIZE=3
HYPER_COUNCIL_CRITIQUE_ROUNDS=1
HYPER_SPECULATIVE_ENABLED=1
HYPER_SPECULATIVE_EDGE_PROVIDERS=groq,cerebras,sambanova

# --- free inference providers (edge tier) ----------------------------------
# Either export them directly or register them through POST /v1/credentials.
GROQ_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_AI_STUDIO_KEY=
FIREWORKS_API_KEY=

# --- headless compute providers --------------------------------------------
# Several accounts per provider are supported: export the extra ones as
# KAGGLE_USERNAME_2 / KAGGLE_KEY_2 (and so on) and give the head node the
# per-account metadata it needs.
KAGGLE_USERNAME=
KAGGLE_KEY=
HF_TOKEN=
GITHUB_TOKEN=
LIGHTNING_API_TOKEN=
OCI_API_KEY=
OCI_TENANCY=
OCI_USER=
# Per-account metadata (JSON): HYPER_CRED_<PROVIDER>_<LABEL>_META={"owner":"alice"}.
# Without a label the metadata belongs to the provider's default account.
HYPER_CRED_KAGGLE_META=
HYPER_CRED_HF_META=
HYPER_CRED_GITHUB_META=
HYPER_CRED_ORACLE_META=

# --- memory (milestone 4) --------------------------------------------------
# The persistent, hybrid vector + keyword memory.
HYPER_MEMORY_ENABLED=1
HYPER_MEMORY_DIR=
HYPER_MEMORY_CHUNK_SIZE=800
HYPER_MEMORY_CHUNK_OVERLAP=120
HYPER_MEMORY_MAX_CHUNKS=20000
HYPER_MEMORY_CONTEXT_TOP_K=4
HYPER_MEMORY_CONTEXT_CHARS=1600

# --- memory cloud sync -----------------------------------------------------
# Where the snapshots are mirrored (both targets are optional).
HYPER_DRIVE_TOKEN=
HYPER_DRIVE_API_BASE=https://www.googleapis.com/drive/v3
HYPER_DRIVE_UPLOAD_BASE=https://www.googleapis.com/upload/drive/v3
HYPER_DRIVE_FOLDER=Hyper-Cluster Memory
HYPER_HUB_TOKEN=
HYPER_HUB_BASE_URL=https://huggingface.co
HYPER_HUB_REPO=

# --- sleep-time self-evolution ---------------------------------------------
HYPER_EVOLUTION_ENABLED=1
# The cluster has to be quiet for this long before it starts learning.
HYPER_EVOLUTION_IDLE_SECONDS=300
# The hard budget: a chat must preempt the training within this many seconds.
HYPER_EVOLUTION_PREEMPT_BUDGET_SECONDS=2
HYPER_EVOLUTION_DATASET_SIZE=16
HYPER_EVOLUTION_DRAFTS_PER_PROMPT=2
HYPER_EVOLUTION_MAX_SHARDS=4
HYPER_EVOLUTION_DIFFICULTY=0.8
HYPER_EVOLUTION_PROMPT_ENABLED=1
HYPER_EVOLUTION_TRAIN_STEPS=24
HYPER_EVOLUTION_TRAIN_DIM=128
HYPER_EVOLUTION_TRAIN_RANK=8
HYPER_EVOLUTION_TRAIN_LEARNING_RATE=0.5
HYPER_EVOLUTION_TRAIN_VOCAB=64
HYPER_EVOLUTION_CHECKPOINT_DIR=

# --- observability ---------------------------------------------------------
HYPER_LOG_LEVEL=INFO
HYPER_LOG_JSON=1
HYPER_LOG_FILE=

# ===========================================================================
# Worker side (worker/bootstrap.sh + worker/worker_agent.py)
# ===========================================================================

# --- worker identity -------------------------------------------------------
# Leave the id empty to derive a stable one from the host name.
HYPER_WORKER_ID=
HYPER_WORKER_PROVIDER=local
HYPER_WORKER_REGION=unknown

# --- control plane connection ---------------------------------------------
HYPER_WORKER_HEAD_URL=http://127.0.0.1:8080
HYPER_WORKER_MESH_TOKEN=change-me-mesh-token

# --- worker HTTP server ----------------------------------------------------
HYPER_WORKER_BIND_HOST=0.0.0.0
HYPER_WORKER_BIND_PORT=8081
HYPER_WORKER_MAX_CONCURRENCY=2
HYPER_WORKER_HEARTBEAT_SECONDS=20
HYPER_WORKER_TTL_SECONDS=3600

# --- model -----------------------------------------------------------------
# The bootstrap script downloads the GGUF and verifies its SHA-256.
HYPER_WORKER_MODEL_REPO=Qwen/Qwen2.5-7B-Instruct-GGUF
HYPER_WORKER_MODEL_FILE=qwen2.5-7b-instruct-q4_k_m.gguf
HYPER_WORKER_MODEL_SHA256=
HYPER_WORKER_MODEL_FAMILY=qwen2
HYPER_WORKER_MODEL_PARAMS_B=7.0
HYPER_WORKER_CONTEXT_SIZE=8192
# -1 = offload every layer to the GPU.
HYPER_WORKER_GPU_LAYERS=-1
# auto | llama.cpp | upstream | simulator
HYPER_WORKER_BACKEND=auto
HYPER_WORKER_UPSTREAM_URL=
HYPER_WORKER_UPSTREAM_MODEL=
HYPER_WORKER_UPSTREAM_API_KEY=

# --- tailscale mesh --------------------------------------------------------
# Auth key with the `tag:hypercluster-worker` tag attached.
HYPER_WORKER_TAILSCALE_AUTH_KEY=
HYPER_WORKER_TAILSCALE_TAGS=hypercluster-worker
HYPER_WORKER_TAILSCALE_HOSTNAME=
HYPER_WORKER_MESH_ENABLED=1

# --- sandboxed tools (worker side) -----------------------------------------
HYPER_WORKER_SANDBOX_ENABLED=1
HYPER_WORKER_SANDBOX_TIMEOUT_SECONDS=20
HYPER_WORKER_SANDBOX_WORKDIR=

# --- head node tool sandbox (head_node/app.py) ----------------------------
HYPER_SANDBOX_ENABLED=1
HYPER_MAX_TOOL_ROUNDS=4
HYPER_SANDBOX_TIMEOUT_SECONDS=20
HYPER_SANDBOX_MEMORY_LIMIT_MB=512

