# ---------------------------------------------------------------------------
# Hyper-Cluster Omega -- configuration template
# Copy to `.env` and fill in. Every key is optional; the defaults work for a
# local development cluster. Secrets are never logged (they are redacted in
# /v1/status and in the log formatter).
# ---------------------------------------------------------------------------

# --- identity --------------------------------------------------------------
HYPER_CLUSTER_NAME=hyper-cluster-omega

# --- control plane ---------------------------------------------------------
HYPER_HEAD_HOST=0.0.0.0
HYPER_HEAD_PORT=8080
# Public URL used by the mobile dashboard (behind a tunnel/reverse proxy).
HYPER_PUBLIC_BASE_URL=

# --- authentication --------------------------------------------------------
# Phone clients present this as `Authorization: Bearer <api_key>`.
HYPER_API_KEY=change-me-please-use-32-random-chars
# Workers present this as `X-Mesh-Token` when registering.
HYPER_MESH_TOKEN=change-me-mesh-token
# Admin operations (drain/remove workers, manage credentials).
HYPER_ADMIN_TOKEN=change-me-admin-token

# --- storage ---------------------------------------------------------------
HYPER_DATA_DIR=~/.hypercluster

# --- worker lifecycle ------------------------------------------------------
# Session lifetime of a provisioned worker (Kaggle/HF runners are ~12h).
HYPER_WORKER_TTL_SECONDS=3600
# Replace a worker this long *before* it expires (10 minutes).
HYPER_HANDOFF_LEAD_SECONDS=600
HYPER_MAX_CONCURRENCY_PER_WORKER=2
HYPER_HEARTBEAT_INTERVAL_SECONDS=20

# --- scheduling ------------------------------------------------------------
HYPER_SCHEDULER_LATENCY_WEIGHT=1.0
HYPER_SCHEDULER_QUEUE_WEIGHT=0.85
HYPER_SCHEDULER_LOAD_WEIGHT=0.5
HYPER_SCHEDULER_COLD_START_PENALTY_MS=8000

# --- hold & requeue --------------------------------------------------------
HYPER_HOLD_ENABLED=1
HYPER_HOLD_QUEUE_MAX_SIZE=512
HYPER_HOLD_REQUEST_TTL_SECONDS=900

# --- reasoning modes -------------------------------------------------------
HYPER_DEFAULT_MODE=auto
HYPER_COUNCIL_SIZE=3
HYPER_COUNCIL_CRITIQUE_ROUNDS=1
HYPER_SPECULATIVE_ENABLED=1
HYPER_SPECULATIVE_EDGE_PROVIDERS=groq,cerebras,sambanova

# --- free inference providers (edge tier) ----------------------------------
# Either export them directly or register them through POST /v1/credentials.
GROQ_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_AI_STUDIO_KEY=
FIREWORKS_API_KEY=

# --- headless compute providers --------------------------------------------
KAGGLE_USERNAME=
KAGGLE_KEY=
HF_TOKEN=
GITHUB_TOKEN=
LIGHTNING_API_TOKEN=
OCI_API_KEY=
OCI_TENANCY=
OCI_USER=

# --- memory & evolution (milestone 4) --------------------------------------
HYPER_MEMORY_ENABLED=1
HYPER_MEMORY_SYNC_DRIVE_FOLDER=
HYPER_MEMORY_SYNC_HF_REPO=
HYPER_EVOLUTION_ENABLED=1
HYPER_EVOLUTION_IDLE_SECONDS=300
HYPER_EVOLUTION_PREEMPT_BUDGET_MS=2000

# --- observability ---------------------------------------------------------
HYPER_LOG_LEVEL=INFO
HYPER_LOG_JSON=1
HYPER_LOG_FILE=

# ===========================================================================
# Worker side (worker/bootstrap.sh + worker/worker_agent.py)
# ===========================================================================

# --- worker identity -------------------------------------------------------
# Leave the id empty to derive a stable one from the host name.
HYPER_WORKER_ID=
HYPER_WORKER_PROVIDER=local
HYPER_WORKER_REGION=unknown

# --- control plane connection ---------------------------------------------
HYPER_WORKER_HEAD_URL=http://127.0.0.1:8080
HYPER_WORKER_MESH_TOKEN=change-me-mesh-token

# --- worker HTTP server ----------------------------------------------------
HYPER_WORKER_BIND_HOST=0.0.0.0
HYPER_WORKER_BIND_PORT=8081
HYPER_WORKER_MAX_CONCURRENCY=2
HYPER_WORKER_HEARTBEAT_SECONDS=20
HYPER_WORKER_TTL_SECONDS=3600

# --- model -----------------------------------------------------------------
# The bootstrap script downloads the GGUF and verifies its SHA-256.
HYPER_WORKER_MODEL_REPO=Qwen/Qwen2.5-7B-Instruct-GGUF
HYPER_WORKER_MODEL_FILE=qwen2.5-7b-instruct-q4_k_m.gguf
HYPER_WORKER_MODEL_SHA256=
HYPER_WORKER_MODEL_FAMILY=qwen2
HYPER_WORKER_MODEL_PARAMS_B=7.0
HYPER_WORKER_CONTEXT_SIZE=8192
# -1 = offload every layer to the GPU.
HYPER_WORKER_GPU_LAYERS=-1
# auto | llama.cpp | upstream | simulator
HYPER_WORKER_BACKEND=auto
HYPER_WORKER_UPSTREAM_URL=
HYPER_WORKER_UPSTREAM_MODEL=
HYPER_WORKER_UPSTREAM_API_KEY=

# --- tailscale mesh --------------------------------------------------------
# Auth key with the `tag:hypercluster-worker` tag attached.
HYPER_WORKER_TAILSCALE_AUTH_KEY=
HYPER_WORKER_TAILSCALE_TAGS=hypercluster-worker
HYPER_WORKER_TAILSCALE_HOSTNAME=
HYPER_WORKER_MESH_ENABLED=1

# --- sandboxed tools (worker side) -----------------------------------------
HYPER_WORKER_SANDBOX_ENABLED=1
HYPER_WORKER_SANDBOX_TIMEOUT_SECONDS=20
HYPER_WORKER_SANDBOX_WORKDIR=

# --- head node tool sandbox (head_node/app.py) ----------------------------
HYPER_SANDBOX_ENABLED=1
HYPER_MAX_TOOL_ROUNDS=4
HYPER_SANDBOX_TIMEOUT_SECONDS=20
HYPER_SANDBOX_MEMORY_LIMIT_MB=512
